rules_version = '2';

// Правила базы (default) проекта Firebase fury-survivors. Публикуются вручную:
// Firestore Database → Rules → вставить файл целиком → Publish.
//
// Клиент анонимный, правила единственная защита: форма документа проверяется полностью,
// записанное нельзя изменить или удалить.
service cloud.firestore {
  match /databases/{database}/documents {
    // Fury Survivors. Границы зеркалят NICK и LIMITS в src/data/leaderboard.js.
    // Общая форма записи таблицы: соло и кооп отличаются только именем (ник или пара 'HOST+GUEST').
    // ip: необязательная строка (публичный IP отправителя, см. IP_FIELD в src/data/leaderboard.js).
    function scoreShape(d) {
      return d.keys().hasOnly(['name', 'score', 'time', 'kills', 'level', 'victory', 'difficulty', 'ip', 'hero', 'stage', 'createdAt'])
        && d.score is int
        && d.score > 0 && d.score < 10000000
        && d.time is int
        && d.time >= 0 && d.time <= 86400
        && d.kills is int
        && d.kills >= 0 && d.kills <= 1000000
        && d.level is int
        && d.level >= 1 && d.level <= 999
        && d.victory is bool
        && (!('difficulty' in d) || d.difficulty in ['normal', 'cursed'])
        && (!('ip' in d) || (d.ip is string && d.ip.size() <= 45))
        // hero: id героя (кооп: пара 'heroine+mage' в порядке ников), stage: id зоны; у старых записей нет
        // (читаются как heroine и forest)
        && (!('hero' in d) || (d.hero is string && d.hero.matches('^[a-z_]{1,20}([+][a-z_]{1,20})?$')))
        && (!('stage' in d) || (d.stage is string && d.stage.matches('^[a-z_]{1,20}$')))
        && d.createdAt == request.time;
    }
    match /fury_scores/{id} {
      allow read: if true;
      allow create: if scoreShape(request.resource.data)
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Za-z0-9]{3,6}$');
      allow update, delete: if false;
    }
    match /fury_scores_coop/{id} {
      allow read: if true;
      allow create: if scoreShape(request.resource.data)
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Za-z0-9]{3,6}\\+[A-Za-z0-9]{3,6}$');
      allow update, delete: if false;
    }
    // Лобби коопа (src/services/net.js): хост кладёт offer, гость один раз дописывает answer.
    // Документ живёт до соединения (хост удаляет), брошенные можно чистить TTL-политикой по createdAt.
    match /rooms/{code} {
      allow get: if true;   // только по коду: список открытых лобби не отдаём
      allow list: if false;
      allow create: if code.matches('^[A-Z0-9]{5}$')
        && request.resource.data.keys().hasOnly(['offer', 'createdAt'])
        && request.resource.data.offer is string
        && request.resource.data.offer.size() < 20000
        && request.resource.data.createdAt == request.time;
      allow update: if !('answer' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'answeredAt'])
        && request.resource.data.answer is string
        && request.resource.data.answer.size() < 20000
        && request.resource.data.answeredAt == request.time;
      allow delete: if true;
    }
    // Резервная копия кодекса игрока (src/services/codex.js, CODEX в src/data/codex.js). Имя документа —
    // случайный id кодекса (20 знаков [a-z0-9]), его знает только владелец: читать по id можно, список нельзя.
    // data: JSON кодекса строкой; nick: ник для поиска владельцем проекта в консоли.
    match /fury_codex/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if id.matches('^[a-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['nick', 'data', 'v', 'updatedAt'])
        && request.resource.data.keys().hasAll(['nick', 'data', 'v', 'updatedAt'])
        && request.resource.data.nick is string
        && request.resource.data.nick.size() <= 6
        && request.resource.data.data is string
        && request.resource.data.data.size() < 800000
        && request.resource.data.v is int
        && request.resource.data.v >= 1 && request.resource.data.v < 1000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
