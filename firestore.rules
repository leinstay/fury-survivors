rules_version = '2';

// Правила базы (default) проекта Firebase fury-survivors. Публикуются вручную:
// Firestore Database → Rules → вставить файл целиком → Publish.
//
// Клиент анонимный, правила единственная защита: форма документа проверяется полностью,
// записанное нельзя изменить или удалить.
service cloud.firestore {
  match /databases/{database}/documents {
    // Fury Survivors. Границы зеркалят NICK и LIMITS в src/data/leaderboard.js.
    match /fury_scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'time', 'kills', 'level', 'victory', 'difficulty', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Za-z0-9]{3,6}$')
        && request.resource.data.score is int
        && request.resource.data.score > 0 && request.resource.data.score < 10000000
        && request.resource.data.time is int
        && request.resource.data.time >= 0 && request.resource.data.time <= 86400
        && request.resource.data.kills is int
        && request.resource.data.kills >= 0 && request.resource.data.kills <= 1000000
        && request.resource.data.level is int
        && request.resource.data.level >= 1 && request.resource.data.level <= 999
        && request.resource.data.victory is bool
        && (!('difficulty' in request.resource.data) || request.resource.data.difficulty in ['normal', 'cursed'])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
